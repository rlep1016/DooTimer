<Window x:Class="DooTimer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DooTimer.Converters"
        Title="DooTimer" Width="1000" Height="660"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="16,4,16,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BlueHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  导航按钮 -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <TextBlock Grid.Row="0" Text="DooTimer" FontSize="21" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="18,24,18,14"/>

                <!-- 分隔线 -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource LineBrush}"
                        Margin="18,4,18,2"/>

                <!-- 导航按钮 -->
                <Button x:Name="BtnOverview" Grid.Row="2" Style="{StaticResource ActiveSidebarButton}"
                        Click="NavClick" Tag="overview">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,3 h4 v4 h-4 z M9,3 h4 v4 h-4 z M3,9 h4 v4 h-4 z M9,9 h4 v4 h-4 z" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="总览" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSettings" Grid.Row="3" Style="{StaticResource SidebarButton}"
                        Click="NavClick" Tag="settings">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,4 h12 M4,2 v4 M2,9 h12 M8,7 v4 M2,14 h12 M6,12 v4" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="设置" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnData" Grid.Row="4" Style="{StaticResource SidebarButton}"
                        Click="NavClick" Tag="data">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,14 v-9 h3 v9 z M6,14 v-6 h3 v6 z M10,14 v-3 h3 v3 z" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="数据" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAbout" Grid.Row="5" Style="{StaticResource SidebarButton}"
                        Click="NavClick" Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,14 A6,6 0 1,0 8,2 A6,6 0 1,0 8,14 Z M8,6 v5 M8,4.5 v1" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                        <TextBlock Text="关于" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 状态指示 -->
                <Border x:Name="SideStatus" Grid.Row="6" CornerRadius="12" Margin="18,22,18,8" Height="34"
                        Background="{DynamicResource GreenSoftBrush}">
                    <TextBlock x:Name="SideStatusText" Text="未检测到抖音" FontSize="13" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="7" Text="关闭主窗口后仍会在托盘继续监控。" Foreground="{DynamicResource Muted2Brush}" FontSize="12"
                           Margin="22,0,22,0" TextWrapping="Wrap"/>

                <!-- 退出 -->
                <Button Grid.Row="10" Content="退出 DooTimer" Height="38"
                        Margin="18,0,18,22"
                        Background="{DynamicResource RedSoftBrush}"
                        Foreground="{DynamicResource RedBrush}"
                        FontWeight="Bold"
                        Style="{StaticResource RoundedButton}"
                        Click="Exit_Click"/>
            </Grid>
        </Border>

        <!-- 涓诲唴瀹瑰尯 -->
        <Border Grid.Column="1" Background="{DynamicResource BgBrush}">
            <Grid Margin="30,28,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 椤靛ご -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="HeaderTitle" Text="总览" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Row="1" x:Name="HeaderSubtitle"
                               Text="实时查看检测状态、今日用时和剩余额度。" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,4,0,0"/>
                </Grid>

                <!-- 椤甸潰鍐呭 -->
                <ContentControl Grid.Row="1" x:Name="PageContent"/>
            </Grid>
        </Border>
    </Grid>
</Window>

