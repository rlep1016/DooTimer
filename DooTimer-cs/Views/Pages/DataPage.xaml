<UserControl x:Class="DooTimer.Views.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DooTimer.Converters">
    <UserControl.Resources>
        <converters:SecondsToTextConverter x:Key="SecondsToText"/>
        <converters:SecondsToCompactConverter x:Key="SecondsToCompact"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 今日摘要 -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="24" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Margin="0,0,0,14" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="0,22,8,22">
                        <StackPanel>
                            <TextBlock Text="今日累计" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="DataTotalLabel" Text="0 分 0 秒" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="4,22,4,22">
                        <StackPanel>
                            <TextBlock Text="今日次数" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="DataSessionsLabel" Text="0 次" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="8,22,0,22">
                        <StackPanel>
                            <TextBlock Text="剩余额度" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="DataRemainingLabel" Text="60 分钟" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 第二行：更多统计 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="0,8,8,22">
                        <StackPanel>
                            <TextBlock Text="较上周同期" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="WeekCompareLabel" Text="暂无数据" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="4,8,4,22">
                        <StackPanel>
                            <TextBlock Text="今日最长单次" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="LongestSessionLabel" Text="0 分 0 秒" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="24" Padding="16,14" Margin="8,8,0,22">
                        <StackPanel>
                            <TextBlock Text="今日平均每次" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="AvgSessionLabel" Text="0 分 0 秒" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 导出 -->
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ExportMessage" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Button Grid.Column="1" Content="导出 CSV" Width="116" Height="38"
                                Background="{DynamicResource BlueBrush}" Foreground="White"
                                Style="{StaticResource RoundedButton}" Click="ExportCsv_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 7天趋势 -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="24" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Margin="0,0,0,14" Padding="22">
                <StackPanel>
                    <TextBlock Text="最近 7 天" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,20,0,4"/>
                    <TextBlock x:Name="WeekSummaryLabel" Text="本周累计 0 分 0 秒 · 日均 0 分 0 秒"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                    <Grid x:Name="WeekChart" Height="132" Margin="0,0,0,20"/>
                </StackPanel>
            </Border>

            <!-- 24 小时分布 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="24" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Margin="0,0,0,14" Padding="22">
                <StackPanel>
                    <TextBlock Text="今日 24 小时分布" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,20,0,4"/>
                    <TextBlock x:Name="HourlySummaryLabel" Text="每个时段的具体用时"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,20" PreviewMouseWheel="HourlyScroll_PreviewMouseWheel">
                        <Grid x:Name="HourlyChart" Height="160" MinWidth="960"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 最近记录 -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="24" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="最近记录" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,20,0,10"/>
                    <StackPanel x:Name="SessionsList" Margin="0,0,0,18"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>